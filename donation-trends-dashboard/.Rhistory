# 01_data_cleaning.R
# Purpose: load raw donation data and do basic cleaning
# Load libraries
library(dplyr)
library(lubridate)
# For now, let's create some fake donation data to practice
raw_donations <- data.frame(
donor_id = 1:5,
amount = c(50, 100, 25, 75, 200),
date = c("2024-01-15", "2024-02-10", "2024-02-20", "2024-03-05", "2024-03-15")
)
# Convert date column to Date type
raw_donations <- raw_donations %>%
mutate(date = ymd(date))
# Preview the data
print(raw_donations)
# Save cleaned data to the "data" folder
write.csv(raw_donations, "data/cleaned_donations.csv", row.names = FALSE)
# 01_data_cleaning.R
# Purpose: load raw donation data and do basic cleaning
# Load libraries
library(dplyr)
library(lubridate)
# For now, let's create some fake donation data to practice
raw_donations <- data.frame(
donor_id = 1:5,
amount = c(50, 100, 25, 75, 200),
date = c("2024-01-15", "2024-02-10", "2024-02-20", "2024-03-05", "2024-03-15")
)
# Convert date column to Date type
raw_donations <- raw_donations %>%
mutate(date = ymd(date))
# Preview the data
print(raw_donations)
# Save cleaned data to the "data" folder
write.csv(raw_donations, "data/cleaned_donations.csv", row.names = FALSE)
View(raw_donations)
